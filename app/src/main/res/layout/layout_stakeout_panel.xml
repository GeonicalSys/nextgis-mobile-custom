<?xml version="1.0" encoding="utf-8"?>
<com.nextgis.maplibui.view.FittedPanelLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stakeout_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_stakeout_panel"
        android:orientation="vertical">
        <com.nextgis.maplibui.view.ReflowingGuidanceHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/stakeout_direction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/stakeout_direction"
                android:padding="8dp"
                android:src="@drawable/ic_stakeout" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <com.nextgis.maplibui.view.WrappingLabel
                    android:id="@+id/stakeout_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/stakeout_waiting_for_gps"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/stakeout_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/stakeout_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stakeout_stop"
                    android:padding="12dp"
                    android:src="@drawable/ic_stakeout_stop" />
                <ImageButton
                    android:id="@+id/stakeout_sound"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/stakeout_mute"
                    android:padding="12dp"
                    android:src="@drawable/ic_stakeout_sound_on" />
            </LinearLayout>
        </com.nextgis.maplibui.view.ReflowingGuidanceHeader>
    </LinearLayout>
</com.nextgis.maplibui.view.FittedPanelLayout>
