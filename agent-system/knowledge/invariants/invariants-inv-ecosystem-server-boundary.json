        "title": "Desktop and Android integrate through explicit server contracts",
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "Android runtime never reads standart_profiles, QGIS plugin mirrors, variables.py or other desktop workspace files; shared data crosses through NextGIS Web/Collector with explicit identity, schema and permission semantics or through explicit import of a supported portable artifact.",
        "related_code": [
          "app/src/main/java/com/nextgis/mobile/activity/MainActivity.kt",
          "maplib/src/main/java/com/nextgis/maplib/datasource/ngw/ResourceGroup.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/NGWResourceImportHelper.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/CollectorProjectRegistry.java"
        ],
        "verify_smoke": [
          "SMOKE-NGW-URL-IMPORT",
          "SMOKE-COLLECTOR-IMPORT",
          "SMOKE-MULTI-ACCOUNT-SYNC"
        ],
        "must_update_docs": [
          "docs/architecture/lisa-ecosystem.md",
