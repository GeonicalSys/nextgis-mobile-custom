        "id": "UI-MAP-STATUS-COORDINATES",
        "group": "location",
        "title": "Координаты устройства в нижней панели",
        "surface": "Map status panel",
        "variants": [
          "lisa",
          "belka"
        ],
        "widgets": [
          "tv_latitude",
          "tv_longitude",
          "fl_status_panel"
        ],
        "meaning": "Latitude/longitude of the selected display Location, not camera centre, project extent centre or selected feature. mCurrentCenter is also a device-position field despite its name.",
        "value_origin": "GpsEventSource.lastDisplayLocation -> callbacks -> fillTextViews -> formatCoordinate -> tv_latitude/tv_longitude",
        "units": "WGS84 angular latitude/longitude; coordinates_format and coordinates_fraction_digits change presentation only.",
        "updates": [
          "GPS/display callback and updateLastLocation; resume reloads format preferences."
        ],
        "actions": [
          "Pan/zoom separately; coordinate settings change representation."
        ],
        "conditions": [
          "show_status_panel/mode visibility; available display Location; upstream permissions/provider eligibility."
        ],
        "saved_state": "Formatting/display preferences persist; camera scroll state and geometry are separate.",
        "source_ids": [
          "map-last-display",
          "map-status-location",
          "map-status-bind",
          "map-format-coordinate",
          "map-resume-settings",
          "map-device-fix"
        ],
        "expectations": [
          "With identical display fix and displaced camera, panel must identify that fix. Counterexample: reading map centre as phone coordinates is invalid.",
          "Changing format must not modify underlying Location or feature geometry."
        ],
        "unknowns": [
