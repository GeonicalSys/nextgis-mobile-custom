    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "NGW resource errors use only a live Activity window",
        "owners": [
          "maplibui"
        ],
        "statement": "Asynchronous NGW connection and resource-tree failures may use application context for background work and localized strings, but a user dialog must use the owning Activity only while it is neither finishing nor destroyed. A late result after the selector lifecycle ends is discarded from UI and must never terminate the process with BadTokenException.\n",
        "related_code": [
          "maplibui/src/main/java/com/nextgis/maplibui/dialog/NGWResourcesListAdapter.java"
        ],
        "verify_smoke": [
          "AUTO-MAPLIBUI-ASSEMBLE",
          "SMOKE-NGW-CONNECTION-FAILURE"
        ],
        "must_update_docs": [
          "maplibui/docs/README.md",
          "maplibui/docs/manifest.yaml",
          "docs/reference/official-differences.md"
        ]
      }
    }
  },
