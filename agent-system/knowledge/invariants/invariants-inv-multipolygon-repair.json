    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Invalid multi-polygons repair into one feature before attribute entry",
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "Automatic topology repair is enabled only when the selected layer type is exactly GTMultiPolygon. A valid input remains unchanged; an invalid input may split or union polygonal parts but must produce one valid GeoMultiPolygon with the original CRS, one feature and one attribute-form handoff. Empty, non-polygonal or still-invalid repair output blocks Save and keeps geometry editing active. GTPolygon, LineString and MultiLineString retain their existing behavior and never enter this repair path. MapLibre conversion assigns CRS to the multi-polygon, polygons and rings. For drafts created by an older conversion, repair recovers a missing collection CRS from the nested polygon, ring or point before the JTS round trip. A ring with fewer than three distinct positions is classified before topology repair and must show the standard insufficient-points message rather than a repair-failed message.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/util/MultiPolygonGeometryRepair.java",
          "maplib/src/test/java/com/nextgis/maplib/util/MultiPolygonGeometryRepairTest.java",
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "SMOKE-MULTIPOLYGON-REPAIR"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/reference/official-differences.md",
          "maplib/docs/README.md",
          "app/docs/README.md"
        ]
      }
    }
