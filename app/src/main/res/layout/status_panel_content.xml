<?xml version="1.0" encoding="utf-8"?>
<com.nextgis.mobile.view.MapStatusPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.nextgis.maplibui.view.WrappingRow android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="5dp">
        <TextView android:id="@+id/tv_latitude" style="@style/status_panel_text" />
        <TextView android:id="@+id/tv_longitude" style="@style/status_panel_text" />
        <TextView android:id="@+id/tv_zoom" style="@style/status_panel_text" android:text="17z" />
        <TextView android:id="@+id/tv_source" style="@style/status_panel_text" />
        <TextView android:id="@+id/tv_accuracy" style="@style/status_panel_text" android:drawableStart="@drawable/ic_accuracy" />
        <TextView android:id="@+id/tv_altitude" style="@style/status_panel_text" android:drawableStart="@drawable/ic_altitude" />
        <TextView android:id="@+id/tv_speed" style="@style/status_panel_text" android:drawableStart="@drawable/ic_speed" />
    </com.nextgis.maplibui.view.WrappingRow>
</com.nextgis.mobile.view.MapStatusPanel>
