      "value": {
        "type": "device",
        "scope": [
          "app",
          "maplib",
          "maplibui"
        ],
        "steps": [
          "Start a slow multi-account synchronization with a stalled GET",
          "open layer loading",
          "underlay catalog or project create/rename/delete",
          "verify the warning offers cancel/continue",
          "confirm interruption and measure cancel-to-worker-stop",
          "repeat while one outbound edit is awaiting its response",
          "then complete the requested action"
        ],
        "expected": "A stalled read and tracked apply stop within a few seconds and rollback without partial rows; an already-sent mutation is the only request allowed to finish and its local change record follows the confirmed result; the spinner remains active until every data-sync lease finishes and the next action starts only after release."
      }
    }
