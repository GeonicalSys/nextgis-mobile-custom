      "value": {
        "title": "Local vector tiles render without external network connectivity",
        "owners": [
          "maplibui",
          "app"
        ],
        "statement": "Local supported vectors render directly from SQLite without an HTTP server or forced SDK connected override. SDK networking, Android NetworkUtil and WorkManager reflect actual external connectivity. Rendering never changes device radios or upload/update intent. Native radio/offline coverage is emulator-only and restores owned network state; the post-removal test remains NOT_RUN.",
        "related_code": [
          "maplibui/src/main/java/com/nextgis/maplibui/GISApplication.java",
          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorTileProvider.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/DirectVectorTilesTest.java"
        ],
        "verify_smoke": [
          "AUTO-LOCAL-VECTOR-TILE-OFFLINE"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/reference/official-differences.md",
          "maplibui/docs/README.md",
          "maplibui/docs/manifest.yaml"
        ]
