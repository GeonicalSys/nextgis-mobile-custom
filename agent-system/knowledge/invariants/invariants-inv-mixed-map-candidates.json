      "role": "complete_registry_definition",
      "value": {
        "title": "A normal tap offers all eligible tracks and vector objects together",
        "owners": [
          "app",
          "maplib"
        ],
        "statement": "Collect vector SQL candidates with the existing inclusion and geometry-refinement policy plus visible native track IDs before choosing. Points and tracks never suppress each other or other vector geometry types. Deduplicate track segments by ID, retain layer plus feature identity separately from track identity, use a single scrolling chooser for multiple candidates, and select one candidate directly. Retain tool gestures, cancel without selection, reject stale map callbacks and dismiss the chooser with its view.",
        "related_code": [
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt",
          "app/src/main/java/com/nextgis/mobile/util/MapSelectionDialog.java",
          "maplib/src/main/java/com/nextgis/maplib/map/MapDrawable.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/TrackControlsTest.java"
        ],
        "verify_smoke": [
          "AUTO-MOBILE-RELATED",
          "AUTO-MAPLIB-UNIT"
        ],
        "must_update_docs": [
          "docs/architecture/track-controls.md",
          "docs/architecture/map-rendering.md",
          "app/docs/README.md",
          "maplib/docs/README.md"
        ]
      }
