    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "One whole label follows the visible part of a linear object",
        "owners": [
          "maplib",
          "app"
        ],
        "statement": "Native LineString/MultiLineString labels use one point anchor per SQL ID in the current screen quadrilateral and a length-weighted predominant visible direction. The word stays rigid even when no straight segment can fit it. Camera/source work coalesces off the UI thread using loaded geometry; stale map/style results never apply. Original geometry, picking, SQL and upload stay unchanged. Native fonts, category paint, zoom and collision remain active.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/VisibleLineLabelLayout.java",
          "maplib/src/main/java/com/nextgis/maplib/map/VisibleLineLabelController.java",
          "maplib/src/main/java/com/nextgis/maplib/map/RuleLabelLayouts.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/VisibleLineLabelsTest.java"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "AUTO-MOBILE-RELATED"
        ],
        "must_update_docs": [
          "docs/architecture/visible-line-labels.md",
          "docs/architecture/map-rendering.md"
        ]
      }
    }
  },
