    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Copying creates an independent compatible feature with destination category precedence",
        "verify_smoke": [
          "AUTO-FEATURE-EDITING",
          "SMOKE-FEATURE-COPY-TRANSFORM"
        ],
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "A selected vector feature may be copied from a read-only source into another editable current-map layer only through lossless same-family single/multi compatibility. Match exact schema keys and compatible scalar types; never copy row identity. Destination category defaults override copied values. Save validates the normal destination form and preserves unbound fields, SQL NULL, empty strings, typed values and durable recovery. Cancellation never changes the source.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/util/FeatureCopyPolicy.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/FeatureCopyDefaults.java",
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt"
        ],
        "must_update_docs": [
          "docs/architecture/feature-copy-transform.md",
          "docs/architecture/feature-type-creation.md"
        ]
      }
    }
  },
