    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "One installation owns track history independently of project workspaces",
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "All projects use one private track database, durable spool and shared layer visibility. Resolve the actual legacy layers.db through DatabaseContext; missed histories import beside post-update tracks. SQL NULL legacy colors are filled once during schema-v2 upgrade or late import while explicit colors stay unchanged. Sent flags, segments, UUID acknowledgements and atomic backup/new pending points migrate transactionally without modifying sources; source provenance prevents duplicate bootstrap copies and deleted history reimport. Project deletion retains common tracks. Recording project-switch guards remain enabled.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/SharedTrackStore.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/SharedTrackProjects.java",
          "app/src/androidTest/java/com/nextgis/mobile/reliability/SharedTracksTest.java"
        ],
