<com.nextgis.mobile.view.ResponsiveMapLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maprl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapViewMaplibre"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fab:maplibre_enableTilePrefetch="@bool/maplibre_enable_tile_prefetch"
        fab:maplibre_renderTextureMode="@bool/maplibre_use_texture_view"
        fab:maplibre_uiAttribution="false"
        fab:maplibre_uiLogo="false" />
    <ImageView
        android:id="@+id/iv_center_cross"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:clickable="false"
        android:focusable="false"
        android:src="@drawable/ic_center_cross_red"
        android:visibility="gone" />
    <View
        android:id="@+id/map_overlay_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/fl_compass" />
    <com.nextgis.maplibui.view.FittedPanelLayout
        android:id="@+id/fl_compass"
        android:layout_width="@dimen/map_compass_size"
        android:layout_height="@dimen/map_compass_size"
        android:layout_marginTop="?attr/actionBarSize" />
    <com.nextgis.maplibui.view.FittedPanelLayout
        android:id="@+id/gnss_hud"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/map_compass_size"
        android:layout_alignTop="@id/fl_compass"
        android:layout_toEndOf="@id/fl_compass"
        android:layout_toRightOf="@id/fl_compass"
        android:layout_toStartOf="@id/map_control_rail"
        android:layout_toLeftOf="@id/map_control_rail"
        android:layout_marginStart="4dp"
        android:layout_marginLeft="4dp"
        android:background="#CC1B1B1B"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/gnss_hud_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/gnss_hud_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </com.nextgis.maplibui.view.FittedPanelLayout>
    <com.nextgis.mobile.view.MapControlRail
        android:id="@+id/map_control_rail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_above="@id/map_action_row"
        android:padding="8dp">
        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/action_measurements"
            android:contentDescription="@string/measurement_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fab:fab_addButtonColorNormal="?attr/colorPrimary"
            fab:fab_addButtonColorPressed="?attr/colorAccent"
            fab:fab_addButtonPlusIconColor="@android:color/white"
            fab:fab_icon="@drawable/ic_ruler"
            fab:fab_size="mini" />
        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/action_track_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/track_start"
            fab:fab_addButtonColorNormal="?attr/colorPrimary"
            fab:fab_addButtonColorPressed="?attr/colorAccent"
            fab:fab_addButtonPlusIconColor="@android:color/white"
            fab:fab_icon="@drawable/ic_action_maps_directions_walk"
            fab:fab_size="mini" />
        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/action_zoom_in"
            android:contentDescription="@string/map_zoom_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fab:fab_addButtonColorNormal="?attr/colorPrimary"
            fab:fab_addButtonColorPressed="?attr/colorAccent"
            fab:fab_addButtonPlusIconColor="@android:color/white"
            fab:fab_icon="@drawable/ic_plus"
            fab:fab_size="mini" />
        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/action_zoom_out"
            android:contentDescription="@string/map_zoom_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fab:fab_addButtonColorNormal="?attr/colorPrimary"
            fab:fab_addButtonColorPressed="?attr/colorAccent"
            fab:fab_addButtonPlusIconColor="@android:color/white"
            fab:fab_icon="@drawable/ic_minus"
            fab:fab_size="mini" />
    </com.nextgis.mobile.view.MapControlRail>
    <View
        android:id="@+id/map_action_row"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_above="@id/fl_status_panel" />
    <FrameLayout
        android:id="@+id/fl_attributes"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="?attr/actionBarSize" />
    <FrameLayout
        android:id="@+id/fl_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
    <LinearLayout
        android:id="@+id/map_corner_stack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/fl_status_panel"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/ll_ruler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iv_ruler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/tv_ruler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>
        <TextView
            android:id="@+id/osm_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="1dp"
            android:clickable="true"
            android:contentDescription="@string/osm_attribution"
            android:ellipsize="none"
            android:focusable="true"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/osm_attribution"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/stylingProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6C6D6C6C"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_margin="16dp"
            android:background="@android:color/white">
            <ProgressBar
                android:id="@+id/progressFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />
            <TextView
                android:id="@+id/textStyling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxWidth="200dp"
                android:text=""
                android:textAlignment="center" />
        </LinearLayout>
    </RelativeLayout>
    <com.nextgis.maplibui.view.FittedPanelLayout
        android:id="@+id/map_panels_stack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/fl_status_panel"
        android:layout_below="@id/map_overlay_top"
        android:layout_toStartOf="@id/map_control_rail"
        android:layout_toLeftOf="@id/map_control_rail"
        android:layout_margin="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom">
            <include layout="@layout/layout_stakeout_panel" />
            <include layout="@layout/layout_azimuth_panel" />
            <com.nextgis.maplibui.view.TrackSelectionPanel
                android:id="@+id/track_selection_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />
            <com.nextgis.maplibui.view.WalkRecordingPanel
                android:id="@+id/walk_recording_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.nextgis.maplibui.view.FittedPanelLayout>
    <com.nextgis.maplibui.view.FittedPanelLayout
        android:id="@+id/creation_actions_host"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_above="@id/fl_status_panel">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end">
            <com.nextgis.mobile.view.MapActionsMenu
                android:id="@+id/multiple_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                fab:fab_addButtonColorNormal="?attr/colorPrimary"
                fab:fab_addButtonColorPressed="?attr/colorAccent"
                fab:fab_addButtonPlusIconColor="@android:color/white"
                fab:fab_expandDirection="left"
                android:layout_gravity="end|bottom">
                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/add_geometry_by_walk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    fab:fab_colorNormal="?attr/colorPrimary"
                    fab:fab_colorPressed="?attr/colorAccent"
                    fab:fab_icon="@drawable/ic_action_maps_directions_walk"
                    fab:fab_size="mini" />
                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/add_new_geometry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    fab:fab_colorNormal="?attr/colorPrimary"
                    fab:fab_colorPressed="?attr/colorAccent"
                    fab:fab_icon="@drawable/ic_action_edit_light"
                    fab:fab_size="mini" />
                <com.getbase.floatingactionbutton.FloatingActionButton
                    android:id="@+id/add_current_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    fab:fab_colorNormal="?attr/colorPrimary"
                    fab:fab_colorPressed="?attr/colorAccent"
                    fab:fab_icon="@drawable/ic_action_maps_place"
                    fab:fab_size="mini" />
            </com.nextgis.mobile.view.MapActionsMenu>
            <com.getbase.floatingactionbutton.FloatingActionButton
                android:id="@+id/add_point_by_tap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                fab:fab_addButtonColorNormal="?attr/colorPrimary"
                fab:fab_addButtonColorPressed="?attr/colorAccent"
                fab:fab_addButtonPlusIconColor="@android:color/white"
                fab:fab_icon="@drawable/ic_action_add_point"
                android:layout_gravity="end|bottom" />
        </FrameLayout>
    </com.nextgis.maplibui.view.FittedPanelLayout>
</com.nextgis.mobile.view.ResponsiveMapLayout>
