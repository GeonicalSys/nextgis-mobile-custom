          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorFeatureReader.java",
          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorTileRequest.java",
          "maplib/src/main/java/com/nextgis/maplib/util/MapRuntimeDiagnostics.java",
          "maplib/src/main/java/com/nextgis/maplib/map/NativeVectorTileEncoder.java",
          "maplib/src/main/java/com/nextgis/maplib/map/NativeVectorTilePropertyCodec.java",
          "maplib/src/main/java/com/nextgis/maplib/map/NativeVectorTileClipper.java",
          "maplib/src/main/java/com/nextgis/maplib/map/MapDrawable.java",
