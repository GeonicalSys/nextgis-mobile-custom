    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Failed track writes and Stop retain the shared-store tail",
        "owners": [
          "maplib",
          "maplibui",
          "app"
        ],
        "statement": "Map/menu/notification require confirmation before recording Stop; Cancel/Back preserve intent. A durable user-session UUID rejects stale confirmations and survives recovery/split. Sampled points enter a bounded ordered application-owned shared-track queue before idempotent UUID SQLite insert. A failed write retains the point; pending files are removed only after commit. Stop intent, track row and recording flag survive until the full tail drains and session closure commits. Corrupt checkpoints block silent recovery. Disk-full RAM fallback cannot survive process death until durable persistence succeeds; this limit must remain explicit.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/util/PendingTrackPoints.java",
          "maplib/src/main/java/com/nextgis/maplib/map/TrackLayer.java",
          "maplibui/src/main/java/com/nextgis/maplibui/service/TrackerService.java"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "AUTO-RELIABILITY-NATIVE",
          "SMOKE-RELIABILITY-FAILURES",
          "SMOKE-GPS-RECORDING"
        ],
        "must_update_docs": [
          "docs/architecture/crash-recovery.md",
          "docs/architecture/location-pipeline.md"
        ]
      }
    }
  },
