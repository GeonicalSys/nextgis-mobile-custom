    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Local features and sync records share one owning-map commit",
        "owners": [
          "maplib",
          "maplibui"
        ],
        "statement": "Feature writes and strict outbox mutations use the owning layer database in one transaction. Read failure cannot mean an empty outbox. Notifications, mutation generation and feature or NGW attachment file deletion publish only after commit. UUID operation journals reconcile lost insert replies; form or attachment failure retains the draft and assigned id for retry. Files and SQLite form a recoverable workflow, not one atomic cross-store transaction.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/util/LayerDatabaseTransaction.java",
          "maplib/src/main/java/com/nextgis/maplib/util/FeatureSaveJournal.java",
          "maplib/src/main/java/com/nextgis/maplib/map/VectorLayer.java",
          "maplibui/src/main/java/com/nextgis/maplibui/activity/ModifyAttributesActivity.java"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "AUTO-RELIABILITY-NATIVE",
          "SMOKE-RELIABILITY-FAILURES"
        ],
        "must_update_docs": [
          "docs/architecture/ngw-sync-and-storage.md",
          "docs/architecture/crash-recovery.md"
        ]
      }
    }
  },
