      "value": {
        "title": "Only visible vector layers participate in tap and long-press identification",
        "owners": [
          "maplib",
          "app"
        ],
        "statement": "LayerIdentifyPolicy requires a nonnull visible vector layer. Old local_vector_tiles origin metadata does not bypass hidden-layer selection. Tap and long-press share this rule. Turning rendering off preserves original SQLite geometry, attributes, schema and editing/sync rights; it does not implicitly expose hidden objects through the map.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/LayerIdentifyPolicy.java",
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt",
          "maplib/src/test/java/com/nextgis/maplib/map/LayerIdentifyPolicyTest.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/DirectVectorTilesTest.java"
        ],
        "verify_smoke": [
          "SMOKE-HIDDEN-VECTOR-TILE-IDENTIFY"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/reference/official-differences.md",
