    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Native dependent lists preserve parent identity, drafts and historical attributes",
        "owners": [
          "maplib",
          "maplibui",
          "app"
        ],
        "statement": "The optional versioned NGFP namespace is declarative offline data. Parent filters compare stable keys with AND semantics in an acyclic graph of arbitrary depth. An explicit parent change clears all descendants and writes SQL NULL; no first item or remembered value is selected. Immutable definitions, selected keys and original values survive rotation and durable recovery. Save rejects invalid new combinations before feature/attachment writes; unchanged historical values survive. Managed legacy pairs render as separate labelled full-width fields with touch spacing; this presentation change preserves source JSON, field names and pinned draft keys. Existing forms without the namespace retain their legacy behavior. The legacy default path without lisa_form_dependencies remains separate: canonical classobj/typeobj has its own marked defaults, while governed lists retain their existing explicit clear/key/pin policy.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/forms/CascadingLists.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/CascadingFormController.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/CascadingFormElements.java"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "SMOKE-CASCADING-FORM-LISTS",
          "SMOKE-REQUIRED-FIELDS"
        ],
        "must_update_docs": [
          "docs/architecture/cascading-form-lists.md",
          "docs/guides/cascading-form-lists-user-guide.md"
        ]
      }
    }
