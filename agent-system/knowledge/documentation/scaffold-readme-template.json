{
  "schema_version": 2,
  "id": "lisa:mobile:resource:scaffold-readme-template",
  "kind": "resource",
  "owner": "android_projects/android_gisapp",
  "topic": "documentation",
  "status": "active",
  "execution_permission": false,
  "applicability": {
    "review_status": "reviewed",
    "paths": [
      {
        "repository": "android_projects/android_gisapp",
        "include": [
          "docs/templates/module-docs/README.md.tmpl",
          "agent-system/knowledge/documentation/scaffold-readme-template.json",
          "docs/scripts/scaffold_module_docs.py",
          "tools/docs-scaffold.ps1"
        ],
        "exclude": []
      }
    ],
    "scope_refs": [],
    "conditions": [],
    "unknown_behavior": "include_with_unknown_reason"
  },
  "lifecycle": {
    "goal": "not_applicable",
    "implementation": "not_applicable",
    "source_verification": "NOT_APPLICABLE",
    "merge": "not_applicable",
    "runtime_verification": "NOT_APPLICABLE",
    "release": "not_applicable",
    "retention": "Keep the generated portable input for independent docs roots."
  },
  "facets": {
    "view-path": {
      "role": "published_template_path",
      "value": "docs/templates/module-docs/README.md.tmpl"
    },
    "body": {
      "role": "literal_template_lines",
      "value": [
        "---",
        "title: ${module_title_yaml}",
        "module_id: ${module_id}",
        "last_verified: ${today}",
        "---",
        "",
        "# ${module_title}",
        "",
        "> Draft scaffold. Удалить неподтверждённые TODO после изучения кода.",
        "",
        "## Назначение",
        "",
        "TODO: описать ответственность модуля и границу с соседними компонентами.",
        "",
        "## Основные сценарии",
        "",
        "- TODO: добавить пользовательские или runtime workflows.",
        "",
        "## Ограничения и диагностика",
        "",
        "- TODO: описать подтверждённые инварианты и типовые симптомы.",
        "",
        "## Проверки",
        "",
        "См. [manifest.yaml](manifest.yaml) и central smoke registry.",
        ""
      ]
    },
    "scaffold-output": {
      "role": "draft_module_pack_output",
      "value": {
        "path": "docs/README.md",
        "purpose": "Start a module README with draft scope, scenarios, diagnostics and verification prompts."
      }
    }
  },
  "relations": [
    {
      "type": "depends_on",
      "target": "lisa:mobile:resource:scaffold-manifest-template",
      "status": "source_backed"
    }
  ],
  "provenance": {
    "manifest": "agent-system/provenance/documentation.json",
    "scopes": [
      "lisa:mobile:resource:scaffold-readme-template"
    ]
  }
}
