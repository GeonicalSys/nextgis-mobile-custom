<?xml version="1.0" encoding="utf-8"?>
<com.nextgis.maplibui.view.FittedPanelLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/azimuth_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_stakeout_panel"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">
                <com.nextgis.maplibui.view.WrappingLabel
                    android:id="@+id/azimuth_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/stakeout_waiting_for_gps"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/azimuth_bearing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/azimuth_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/azimuth_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/azimuth_close"
                    android:padding="12dp"
                    android:src="@drawable/ic_stakeout_stop" />
            </LinearLayout>
        </LinearLayout>
        <com.nextgis.maplibui.view.WrappingRow
            android:id="@+id/stakeout_correction_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/azimuth_correction"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/stakeout_correction_minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/azimuth_correction_decrease"
                    android:text="@string/azimuth_correction_minus"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/stakeout_correction_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/azimuth_correction"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/stakeout_correction_plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/azimuth_correction_increase"
                    android:text="@string/azimuth_correction_plus"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/stakeout_correction_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/azimuth_correction_reset"
                android:text="@string/azimuth_correction_reset"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp" />
        </com.nextgis.maplibui.view.WrappingRow>
    </LinearLayout>
</com.nextgis.maplibui.view.FittedPanelLayout>
