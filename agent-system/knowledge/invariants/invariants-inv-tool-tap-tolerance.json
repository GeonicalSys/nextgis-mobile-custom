    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Tool placement accepts short micro-drift without swallowing deliberate gestures",
        "owners": [
          "maplib",
          "app"
        ],
        "statement": "Drawing, ruler and azimuth placement share max(12dp, system touch slop), one short single-finger down/up pair and matching MapLibre pan threshold. Long press, cancellation, multi-finger and any larger excursion including return to the start cannot place a point. Normal camera mode restores its original pan threshold. Editable selection immediately shows feature actions; clearing it terminates action mode, while read-only selection remains view-only.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/MapTapGesture.java",
          "maplib/src/main/java/com/nextgis/maplib/map/MapDrawable.java",
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "AUTO-RELIABILITY-NATIVE",
          "SMOKE-TOOL-TAP"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/runbooks/device-smoke-tests.md"
        ]
      }
    }
  },
