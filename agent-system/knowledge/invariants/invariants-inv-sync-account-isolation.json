    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "One NGW account failure does not suppress another account",
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "Keep account sync results isolated, prioritize the active Collector account for manual serial sync, restore each enabled account schedule after restart, and durably request each interrupted project/account pair only for its registered owning workspace, even when another project is open. Pending local edits are sent before a large pull; a failed push prevents remote apply for that layer.",
        "related_code": [
          "app/src/main/java/com/nextgis/mobile/util/OfflineSyncIntentService.java",
          "maplib/src/main/java/com/nextgis/maplib/util/NetworkUtil.java",
          "maplibui/src/main/java/com/nextgis/maplibui/GISApplication.java",
          "maplibui/src/main/java/com/nextgis/maplibui/mapui/SyncAccountWorker.java"
        ],
        "verify_smoke": [
          "SMOKE-MULTI-ACCOUNT-SYNC"
        ],
        "must_update_docs": [
          "docs/architecture/ngw-sync-and-storage.md"
        ]
      }
    }
