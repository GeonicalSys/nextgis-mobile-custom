    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "MapLibre renderer follows the Fragment view lifecycle",
        "owners": [
          "app",
          "maplib"
        ],
        "statement": "Every MapLibre MapView created by MapFragment receives onCreate, onStart, onResume, onPause, onStop, onSaveInstanceState, onLowMemory and onDestroy from the matching Fragment view lifecycle. Returning from another screen, backgrounding, screen lock or Activity recreation must resume rendering; onDestroyView must release the old native renderer and clear only bindings that still point to that destroyed MapView; a late touch event must be discarded before it queries that renderer. Every supported API uses the MapLibre SurfaceView renderer so EGL_CONTEXT_LOST can recreate its context and surface; API 26-28 additionally disables tile prefetch. No API caps MapLibre FPS or keeps CONTINUOUS while the map is idle; recovery on every API uses a short CONTINUOUS burst and then restores WHEN_DIRTY. Resume and completed project-style application request a bounded continuous render and Android-presentation burst. Recovery may complete only after a fully rendered frame with no loading foreground; it must not treat an app- side frame count as MapLibre's internal InitialRenderCallback state. Once app sources/layers are applied, a surviving loading foreground is removed without a full style reload; every pending callback is cancelled on pause or view destruction and the API-specific idle rendering mode is restored.\n",
        "related_code": [
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt",
          "maplib/src/main/java/com/nextgis/maplib/map/MapDrawable.java",
          "app/src/main/res/layout/fragment_map.xml",
          "app/src/main/res/values/maplibre_rendering.xml",
          "app/src/main/res/values-v29/maplibre_rendering.xml"
        ],
        "verify_smoke": [
          "AUTO-APP-RELEASES",
          "SMOKE-MAP-SURFACE-LIFECYCLE"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/reference/official-differences.md",
          "app/docs/README.md",
          "app/docs/manifest.yaml"
        ]
      }
    }
