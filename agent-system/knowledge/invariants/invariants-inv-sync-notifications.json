    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Completed sync cannot leave or recreate its progress notification",
        "owners": [
          "app"
        ],
        "statement": "Optional start/finish/cancel messages default to false in XML and runtime fallback; an explicit user choice is preserved. A queue failure posts one replaceable readable error independently of that preference, and successful retry clears it. Manual/account foreground indicators are silent and last only through the owning service. Inactive progress and post-destroy callbacks cannot repost them; main-process startup clears old service indicators without removing error, GPS or unrelated notifications.\n",
        "related_code": [
          "app/src/main/java/com/nextgis/mobile/util/SyncNotifications.java",
          "app/src/main/java/com/nextgis/mobile/util/OfflineSyncIntentService.java",
          "app/src/main/java/com/nextgis/mobile/datasource/SyncService.java",
          "app/src/main/java/com/nextgis/mobile/datasource/SyncAdapter.java",
          "app/src/main/res/xml/preferences_general.xml"
        ],
        "verify_smoke": [
          "SMOKE-SYNC-NOTIFICATIONS"
        ],
