    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Fresh and persisted vector spatial indexes have explicit complete lifecycle",
        "owners": [
          "maplib",
          "maplibui",
          "app"
        ],
        "statement": "A successful fresh empty create may admit readiness only after actual zero SQL rows and zero live index with identity/generation/size recheck. Native reads remain blocked during active bulk until the existing end boundary; finally, rollback, count failure and nonempty canceled states are not new success proofs. Public clear removes nodes and size and persists dirty removal; load is clean and rejects malformed/partial cardinality and child kinds without publishing prefixes. Valid legacy wire bytes and clean same-path no-write are preserved. Layer-owned missing/invalid derived index recovery uses original SQL IDs/geometries without saving half-loaded subclass identity. Counts do not certify arbitrary ID/envelope equality, disk durability or native content readiness.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/VectorLayer.java",
          "maplib/src/main/java/com/nextgis/maplib/datasource/GeometryRTree.java",
          "maplib/src/test/java/com/nextgis/maplib/map/LocalVectorBulkCacheReadinessTest.java",
          "maplib/src/test/java/com/nextgis/maplib/datasource/GeometryRTreeRecoveryTest.java",
          "maplib/src/main/java/com/nextgis/maplib/util/CoordinatePointLayerImporter.java",
          "maplib/src/main/java/com/nextgis/maplib/util/GeoJSONUtil.java",
          "maplib/src/main/java/com/nextgis/maplib/map/NGWVectorLayer.java",
          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorTileProvider.java",
          "maplibui/src/main/java/com/nextgis/maplibui/service/LayerFillService.java",
          "maplibui/src/main/java/com/nextgis/maplibui/activity/VectorLayerSettingsActivity.java",
          "maplibui/src/main/java/com/nextgis/maplibui/service/RebuildCacheService.java"
        ],
        "must_update_docs": [
          "docs/architecture/map-rendering.md",
          "docs/architecture/ngw-sync-and-storage.md",
          "docs/reference/official-differences.md",
          "maplib/docs/README.md"
