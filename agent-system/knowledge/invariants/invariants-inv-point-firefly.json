    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Firefly core remains crisp and its glow has no interior coverage",
        "owners": [
          "maplib",
          "maplibui",
          "app"
        ],
        "statement": "Marker type 9 shares the existing JSON fields and never changes the blur rendering of types 1–8. Its independent core and outer glow alpha compose without filling a transparent centre. Whole-symbol zoom and one layer-opacity multiplier apply to non-SDF children with the logical layer picking/order/visibility lifecycle. Native images are released after their last owner and CPU bitmaps are bounded. Type selection preserves existing settings; the field-points preset is explicit. Full remains a separate publication gate.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/display/FireflyMarkerRegistry.java",
          "maplib/src/main/java/com/nextgis/maplib/map/mpl/FireflyLayerFactory.java",
          "maplibui/src/main/java/com/nextgis/maplibui/fragment/StyleFragment.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/VectorStyleRenderingTest.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/FireflyStyleEditorTest.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/DirectVectorTilesTest.java"
        ],
        "verify_smoke": [
          "AUTO-POINT-FIREFLY",
          "AUTO-MAPLIB-UNIT",
          "AUTO-MAPLIBUI-ASSEMBLE"
        ],
        "must_update_docs": [
          "docs/architecture/point-firefly.md",
          "docs/architecture/classic-style-verification.md"
        ]
      }
    }
