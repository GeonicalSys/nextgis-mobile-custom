    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Local vector tile work has bounded concurrency and pressure admission",
        "owners": [
          "maplib",
          "app"
        ],
        "statement": "Direct SQLite tile builds use shared cancellable two-permit pre-dispatch admission, per-layer serialization and actual measured system/Java headroom. Source/owner/content/style generations fence late work. Resource pressure is retryable without successful partial PBF, ID thinning or simplification. There is no HTTP server, socket queue or 503 retry route. These bounds do not cap all SDK native allocations or prove OOM impossible. Preserve style order, full original editor reads and visible-only identify semantics.",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/RenderTileWorkGate.java",
          "maplib/src/main/java/com/nextgis/maplib/map/RenderMemoryGuard.java",
          "maplib/src/main/java/com/nextgis/maplib/map/RenderMemoryPolicy.java",
          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorTileProvider.java",
          "maplib/src/main/java/com/nextgis/maplib/map/SqliteVectorSourceBridge.kt",
          "maplib/src/test/java/com/nextgis/maplib/map/SqliteVectorTileAdmissionTest.kt"
        ],
        "verify_smoke": [
          "AUTO-MAPLIB-UNIT",
          "SMOKE-LOCAL-VECTOR-TILE-STRESS"
        ],
        "must_update_docs": [
          "docs/architecture/map-performance.md",
          "docs/architecture/map-rendering.md",
          "docs/reference/official-differences.md",
          "maplib/docs/README.md"
        ]
      }
    }
  },
