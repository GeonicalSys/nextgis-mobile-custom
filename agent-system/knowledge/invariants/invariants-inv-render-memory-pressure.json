    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Resource pressure reduces caches and bounds work without changing layer contents",
        "owners": [
          "maplib",
          "app"
        ],
        "statement": "Decide resource economy from actual remaining free system memory relative to its low-memory threshold and current Java headroom. Nominal device RAM, Android low-RAM class, absolute used memory and self-process native/RSS observations must not independently trigger a warning, cache degradation or work serialization. Nominal RAM class may choose ordinary disk-cache capacity and the allocation reserve only; native/RSS/used counters remain diagnostics, not pressure targets or hard caps. Unknown counters must not be treated as zero free memory. An 8 GiB device with little free memory must receive the same free-headroom protection. Only the current map/view/host epoch receives lifecycle-bound cache callbacks. Keep complete geometry, every eligible feature, source registration, model visibility, editing state, SQLite and sync unchanged. Normal tile work retains two permits; actual resource constraints serialize complete builds fairly, and unavailable headroom yields retryable native pressure rather than successful partial tiles. Cache trimming and SDK onLowMemory do not guarantee eviction of GeoJSONVT's internal index or no OOM. Derived PBF disk caching and direct SQLite CustomVectorSource paging are implemented; native performance, complete styles/edit behavior and 2GiB acceptance remain separate gates.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/map/RenderMemoryGuard.java",
          "maplib/src/test/java/com/nextgis/maplib/map/RenderMemoryGuardTest.java",
          "maplib/src/main/java/com/nextgis/maplib/map/RenderMemoryPolicy.java",
          "maplib/src/main/java/com/nextgis/maplib/map/RenderTileWorkGate.java",
          "maplib/src/main/java/com/nextgis/maplib/map/MapDrawable.java",
          "maplib/src/main/java/com/nextgis/maplib/util/MapRuntimeDiagnostics.java",
          "maplib/src/test/java/com/nextgis/maplib/util/MapRuntimeDiagnosticsTest.java",
          "app/src/main/java/com/nextgis/mobile/fragment/MapFragment.kt",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/RenderMemorySafetyTest.java",
          "app/src/androidTest/java/com/nextgis/mobile/rendering/MapRenderStressTest.java"
        ],
        "verify_smoke": [
          "AUTO-RENDER-MEMORY-UNITS",
          "AUTO-RENDER-MEMORY",
          "SMOKE-RENDER-MEMORY-NATIVE"
        ],
