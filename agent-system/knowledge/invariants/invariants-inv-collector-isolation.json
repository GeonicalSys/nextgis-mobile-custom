    "definition": {
      "role": "complete_registry_definition",
      "value": {
        "title": "Web GIS and local projects use isolated workspaces",
        "owners": [
          "app",
          "maplib",
          "maplibui"
        ],
        "statement": "The first map must belong to an active registered local project; a pre-registry standalone map is copied once into that isolated workspace without deleting its rollback source. Project identity, type, map path, vector layers and drafts must not leak between Web GIS or local projects. Tracks intentionally share one application-owned store under INV-SHARED-TRACKS. ContentProvider operations resolve the active map after every in-process switch, while layer create/insert/schema/delete operations resolve the map that owns the layer through its parent chain and open layers.db beside that map file. A Collector task whose project UID does not match its target group must touch neither files nor SQLite. Deletion may remove only the device workspace after its backup gate.\n",
        "related_code": [
          "maplib/src/main/java/com/nextgis/maplib/datasource/LayerContentProvider.java",
          "maplib/src/main/java/com/nextgis/maplib/map/CollectorProjectMetadata.java",
          "maplib/src/main/java/com/nextgis/maplib/map/MapContentProviderHelper.java",
          "maplib/src/main/java/com/nextgis/maplib/map/VectorLayer.java",
          "maplib/src/main/java/com/nextgis/maplib/util/DatabaseContext.java",
          "maplibui/src/main/java/com/nextgis/maplibui/GISApplication.java",
          "maplibui/src/main/java/com/nextgis/maplibui/service/TrackerService.java",
          "maplibui/src/main/java/com/nextgis/maplibui/util/CollectorProjectRegistry.java",
          "app/src/main/java/com/nextgis/mobile/activity/MainActivity.kt",
          "app/src/main/java/com/nextgis/mobile/activity/ProjectSettingsActivity.kt"
        ],
        "verify_smoke": [
          "SMOKE-COLLECTOR-IMPORT",
          "SMOKE-COLLECTOR-SWITCH",
          "SMOKE-PROJECT-MANAGEMENT"
        ],
        "must_update_docs": [
          "docs/architecture/collector-projects.md"
        ]
      }
    }
